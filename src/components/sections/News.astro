---
import FormattedDate from "../common/FormattedDate.astro";
import Card from "../common/Card.astro";
import Button from "../common/Button.astro";
import { getNieuws } from "../../lib/nieuws";

// Eerst 3 berichten, daarna per 3 erbij via "Laad meer"; "Bekijk archief" gaat naar /nieuws.
// Zonder JS staan alle berichten er gewoon; het script verbergt de rest pas.
const PAGE_SIZE = 3;
const posts = await getNieuws();
---

<section
  class="bg-clr-yellow z-40 text-black relative grid content-center gap-(--space-m) p-(--space-m-xl)"
  id="news"
  aria-label="Nieuws"
  data-page-size={PAGE_SIZE}
>
  <div
    class="grid auto-rows-min gap-(--space-s-m) items-start justify-items-start md:grid-cols-2 lg:grid-cols-3"
    id="news-list"
  >
    {
      posts.map((post, index) => (
        <Card
          href={`/nieuws/${post.id}`}
          imageSrc={post.data.heroImage.src}
          imageAlt={post.data.heroImage.alt}
          title={post.data.title}
          description={post.data.description}
          data-animate-card
          data-news-item
          data-card-index={index}
        >
          <FormattedDate slot="meta" date={post.data.pubDate} />
        </Card>
      ))
    }
  </div>
  <div class="flex flex-wrap items-center justify-center gap-x-(--space-m) gap-y-(--space-xs)">
    {
      posts.length > PAGE_SIZE && (
        <Button variant="outline" data-news-more aria-controls="news-list" hidden>
          Laad meer
        </Button>
      )
    }
    <a
      href="/nieuws"
      class="inline-flex min-h-11 items-center font-bold text-(length:--step--1) underline underline-offset-4 decoration-1 hover:decoration-2"
    >
      Bekijk archief
    </a>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { refreshScrollLength } from "../../utils/smoothScroll";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const section = document.getElementById("news");
  const items = [...document.querySelectorAll<HTMLElement>("[data-news-item]")];
  const more = document.querySelector<HTMLButtonElement>("[data-news-more]");
  const pageSize = Number(section?.dataset.pageSize ?? 3);

  // "Meer nieuws": verberg alles na de eerste pagina en toon per klik de volgende 3.
  // Focus gaat naar de link van het eerste nieuwe bericht, zodat toetsenbord- en
  // schermlezergebruikers op de goede plek verder lezen.
  let shown = Math.min(pageSize, items.length);
  items.slice(shown).forEach((item) => (item.hidden = true));

  if (more && items.length > shown) {
    more.hidden = false;
    more.addEventListener("click", () => {
      const next = items.slice(shown, shown + pageSize);
      next.forEach((item) => (item.hidden = false));
      shown += next.length;

      if (!prefersReducedMotion) {
        // Zelfde binnenkomst als de eerste kaarten: kort omhoog en infaden.
        gsap.fromTo(next, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.6, stagger: 0.1, ease: "power2.out" });
      }
      next[0]?.querySelector<HTMLAnchorElement>("a")?.focus({ preventScroll: false });

      if (shown >= items.length) more.hidden = true;
      // Pagina is langer: Lenis en ScrollTrigger direct de nieuwe lengte laten meten.
      refreshScrollLength();
    });
  }

  // Binnenkomst van de eerste kaarten zodra de sectie in beeld komt.
  if (!prefersReducedMotion) {
    const visible = items.slice(0, shown);
    gsap.set(visible, { opacity: 0, y: 20 });
    ScrollTrigger.create({
      trigger: "#news",
      start: "top 80%",
      once: true,
      onEnter: () => {
        gsap.to(visible, { opacity: 1, y: 0, duration: 0.6, stagger: 0.1, ease: "power2.out" });
      },
    });
  }
</script>
