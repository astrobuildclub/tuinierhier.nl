---
// Intro: teksten in src/content/teksten/intro-links.md en intro-rechts.md
import { getTekst } from "../../lib/teksten";

const links = await getTekst("intro-links");
const rechts = await getTekst("intro-rechts");
---

<section
  class="bg-(--clr-blue) relative z-30 lg:sticky lg:top-0 p-(--space-m-xl) py-(--space-m-2xl)"
  id="about-section"
>
  <div class="grid gap-(--space-s-m) lg:grid-cols-2">
    <div class="lg:col-span-1 text-(length:--step-1) font-bold leading-[133%] [&_p]:m-0 [&_p]:leading-[inherit]">
      <links.Content />
    </div>

    <div
      class="lg:col-span-1 grid gap-(--step--2) text-(length:--step--2) font-bold leading-[150%] [&_p]:m-0 [&_p]:leading-[inherit] [&>p:last-child]:font-medium"
    >
      <rechts.Content />
    </div>
  </div>
</section>
<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  // Register ScrollTrigger
  gsap.registerPlugin(ScrollTrigger);

  // Check for reduced motion preference
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (!prefersReducedMotion && window.innerWidth >= 1024) {
    // Darken effect for sticky section
    const aboutSection = document.getElementById("about-section");
    if (aboutSection) {
      // Create overlay element
      const overlay = document.createElement("div");
      overlay.style.cssText = `
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.65);
        opacity: 0;
        pointer-events: none;
        z-index: 1;
        border-radius: inherit;
      `;
      aboutSection.appendChild(overlay);

      // Animate overlay opacity on scroll
      gsap.to(overlay, {
        opacity: 1,
        ease: "none",
        scrollTrigger: {
          trigger: aboutSection,
          start: "bottom center",
          end: "bottom center",
          scrub: 1,
        },
      });
    }
  }
</script>
