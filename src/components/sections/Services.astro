---
import ServicesAnimation from "../animations/ServicesAnimation.astro";
import { getDiensten, getTekst } from "../../lib/teksten";

// Teksten: src/content/teksten/diensten.md (kop) en diensten/*.md (één bestand per dienst).
const sectie = await getTekst("diensten");
const diensten = await getDiensten();
---

<section
  class="bg-(--clr-pinky) p-(--space-m-2xl) lg:sticky lg:top-[var(--sticky-top,0px)] relative z-30"
  id="services-section"
  data-sticky-fit
>
  <h2 class="text-(length:--step--1) font-semibold">{sectie.titel}</h2>
  <div
    class="grid gap-(--space-xs-s) lg:grid-cols-3 mt-(--space-2xs)"
  >
    {
      diensten.map((dienst) => (
        <div class="flex flex-col gap-(--space-3xs)">
          <h3 class="font-heading text-(length:--step-3) tracking-normal">{dienst.titel}</h3>
          <p class="text-(length:--step--1) font-semibold leading-normal">{dienst.intro}</p>
          <div class="text-(length:--step--2) leading-[150%] mt-(--space-3xs) [&_p]:m-0 [&_p]:leading-[inherit] [&_p+p]:mt-(--space-3xs)">
            <dienst.Content />
          </div>
        </div>
      ))
    }
  </div>
</section>
<ServicesAnimation />
