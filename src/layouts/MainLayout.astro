---
// Component imports
import MainHead from "./MainHead.astro";
import Footer from "../components/layout/Footer.astro";
import SmoothScroll from "../components/animations/SmoothScroll.astro";

// Style imports
// Manrope zelf gehost: alleen de gewichten die we gebruiken (500, 800), alleen Latin.
// Geen verzoek meer naar Google Fonts (AVG: geen IP-adres van bezoekers naar Google).
import "@fontsource/manrope/latin-500.css";
import "@fontsource/manrope/latin-800.css";
import "../styles/global.scss";
import "../styles/tailwind.css";

// TypeScript interface voor props
interface Props {
  title?: string;
  description?: string;
  image?: string;
  robots?: string;
}

// Props met default waarden
const {
  title = "Tuinierhier • Eefje Peddemors",
  description = "Tuinfluencer, plantlover, kweekbeest, tuintijger, gardenista",
  image,
  robots,
}: Props = Astro.props;
---

<html lang="nl">
  <MainHead {title} {description} {image} {robots} />
  <body>
    <a href="#inhoud" class="skip-link">Naar de inhoud</a>
    <div class="page-wrap">
      <main class="main-content" id="inhoud" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
    <SmoothScroll />
    <style>
      /* Skip-link: onzichtbaar tot hij focus krijgt (eerste Tab op de pagina). */
      .skip-link {
        position: fixed;
        top: var(--space-2xs);
        left: var(--space-2xs);
        z-index: 1000;
        padding: var(--space-2xs) var(--space-s);
        background: var(--clr-black);
        color: var(--clr-white);
        font-weight: 700;
        border-radius: 999px;
        translate: 0 -200%;
      }
      .skip-link:focus-visible {
        translate: 0 0;
        outline: 2px solid var(--clr-yellow);
        outline-offset: 2px;
      }
      #inhoud:focus {
        outline: none;
      }

      /* Page wrapper base styles */
      .page-wrap {
        height: 100%;
        background: var(--clr-yellow);
      }

      /* Complex Grid Layout voor page-wrap */
      @media (min-width: 1024px) {
        .page-wrap {
          display: grid;
          grid-template-columns: minmax(25%, 1fr) minmax(75%, 3fr);
          align-items: start;
        }

        footer {
          order: 1;
          height: 100vh;
          position: sticky;
          top: 0;
          z-index: 100; /* Hoogste z-index - altijd bovenop */
        }

        .main-content {
          order: 2;
        }
      }

      /* Main content sections */
      .main-content section {
        padding: var(--space-m-2xl, clamp(1.5rem, 0.6rem + 4.5vw, 6rem));
      }

      /* Content Grid */
      .content {
        display: grid;
        row-gap: 0;
      }

      /* About Section */
      .about {
        background: var(--clr-blue);
        display: grid;
        gap: var(--grid-gutter, var(--space-s-m));
      }

      @media (min-width: 1024px) {
        .about {
          display: grid;
          grid-template-columns: 2fr 1fr;
          gap: var(--grid-gutter, var(--space-s-m));
        }
      }

      /* Info Section */
      .info {
        display: grid;
        gap: var(--space-m, 1.5rem);
      }

      /* Mobile overrides */
      @media only screen and (max-width: 767px) {
        :root {
          --page-margin: var(--global-rem, 1rem);
        }
      }
    </style>
  </body>
</html>
